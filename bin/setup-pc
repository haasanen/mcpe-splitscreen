#!/usr/bin/env bash
# Copyright (c) 2026 haasanen — SPDX-License-Identifier: GPL-3.0-only
# setup-pc — one-shot install on the target desktop:
#   * mcpelauncher-client release (haasanen/mcpelauncher-manifest latest v1.8.x-hN)
#   * gamecontrollerdb mapping pack
#   * config template
# Run on the machine that will actually run the game.
set -euo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
TOKFILE=${GH_TOKEN_FILE:-}
AUTH=(); [ -n "$TOKFILE" ] && AUTH=(-H "Authorization: Bearer $(cat "$TOKFILE")")
MCPE_HOME=${MCPE_HOME:-$HOME/.local/share/mcpe-splitscreen}
mkdir -p "$MCPE_HOME/bin"

latest_asset() { # owner repo regex
  local owner=$1 repo=$2 rx=$3
  curl -sf "${AUTH[@]}" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$owner/$repo/releases/latest" |
  python3 -c "import json,sys,re
r=json.load(sys.stdin)
rx=re.compile(sys.argv[1])
for a in r['assets']:
    if rx.search(a['name']):
        print(a['browser_download_url']); break" "$rx"
}

CLIENT_URL=$(latest_asset haasanen mcpelauncher-manifest '^mcpelauncher-client-.*\.tar\.gz$')
echo "client: $CLIENT_URL"
curl -fL -o /tmp/mcpe-client.tgz "$CLIENT_URL"
tar xzf /tmp/mcpe-client.tgz -C "$MCPE_HOME/bin"

curl -fL -o "$MCPE_HOME/bin/gamecontrollerdb.txt" \
  https://raw.githubusercontent.com/gabomdq/SDL_GameControllerDB/master/gamecontrollerdb.txt

[ -f "$MCPE_HOME/conf/common.conf" ] || { mkdir -p "$MCPE_HOME/conf"; cp "$HERE/conf/common-example.conf" "$MCPE_HOME/conf/common.conf"; }
[ -f "$MCPE_HOME/bin/mcpelauncher-client" ] && echo "installed: $MCPE_HOME/bin/mcpelauncher-client"
"$MCPE_HOME/bin/mcpelauncher-client" --version 2>/dev/null | head -1 || true

# desktop entry for the GUI control panel (what the players actually launch)
if [ -x "$HERE/bin/mcpe-control" ]; then
  mkdir -p "$MCPE_HOME/bin"
  cp "$HERE/bin/mcpe-control" "$MCPE_HOME/bin/mcpe-control" 2>/dev/null || true
  mkdir -p "$HOME/.local/share/applications"
  cat > "$HOME/.local/share/applications/mcpe-control.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Minecraft 4-Player Splitscreen
Comment=Launch four Minecraft instances, one gamepad each
Exec=$MCPE_HOME/bin/mcpe-control
Icon=applications-games
Terminal=false
Categories=Game;
EOF
  echo "desktop entry installed: 'Minecraft 4-Player Splitscreen' in the games menu"
fi
command -v xdotool >/dev/null || echo "NOTE: install xdotool for window auto-tiling: sudo apt install xdotool"
echo "next: open 'Minecraft 4-Player Splitscreen' from the menu (or run bin/mcpe-control), pick each player's gamepad, press START ALL FOUR"
