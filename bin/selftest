#!/usr/bin/env bash
# Copyright (c) 2026 haasanen — SPDX-License-Identifier: GPL-3.0-only
# selftest — verify the harness on the real machine, without needing a full game session.
# Checks: shim enforcement, pad enumeration, client binary, server presence, instance configs.
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
MCPE_HOME=${MCPE_HOME:-$HOME/.local/share/mcpe-splitscreen}
fails=0; warns=0
ok()   { echo "  PASS  $*"; }
bad()  { echo "  FAIL  $*"; fails=$((fails+1)); }
warn() { echo "  WARN  $*"; warns=$((warns+1)); }

echo "[1/5] joyfilter shim enforcement"
if [ ! -f "$HERE/shim/joyfilter.so" ]; then
  bad "shim/joyfilter.so missing (run bin/setup-pc or use the release tarball)"
else
  R=$(LD_PRELOAD="$HERE/shim/joyfilter.so" MCPE_JOY_ALLOWED=/tmp/selftest-allow python3 - <<'EOF'
import os, sys
open('/tmp/selftest-allow','w').close()
try:
    os.open('/dev/input/event99', os.O_RDONLY); print('leaky')
except OSError as e:
    print('gated' if e.errno == 13 else f'errno{e.errno}')
fd = os.open('/tmp/selftest-allow', os.O_RDONLY); os.close(fd)
EOF
) || R=crash
  [ "$R" = gated ] && ok "non-allowlisted /dev/input open denied (EACCES)" || bad "shim not enforcing (got: $R)"
fi

echo "[2/5] gamepads visible to the harness"
PADS=$(python3 "$HERE/bin/mcpe-pads" 2>/dev/null)
if [ -n "$PADS" ]; then ok "pads found:"; echo "$PADS" | sed 's/^/        /'; else warn "no gamepads detected — plug one in and re-run"; fi

echo "[3/5] mcpelauncher-client"
BIN=${MCPE_CLIENT_BIN:-$MCPE_HOME/bin/mcpelauncher-client}
if [ -x "$BIN" ]; then
  OUT=$(SDL_VIDEODRIVER=dummy "$BIN" --version 2>/dev/null || true)
  echo "$OUT" | grep -qE 'mcpelauncher-client .*/ manifest' && ok "client runs: $(echo "$OUT" | grep -m1 'mcpelauncher-client')" || bad "client present but banner check failed"
else
  bad "client binary missing ($BIN) — run bin/setup-pc"
fi

echo "[4/5] bedrock server"
if [ -x "$HERE/server/bedrock_server" ]; then
  ok "server installed ($(cat "$HERE/server/version.txt" 2>/dev/null || echo version unknown))"
else
  warn "server not installed yet — run bin/bds-update && bin/bds-run"
fi

echo "[5/5] instance configs"
found=0
for f in "$HERE"/conf/instance-*.conf; do
  [ -f "$f" ] || continue
  case "$(basename "$f")" in *example*) continue ;; esac
  found=$((found+1))
  PAD=$(sed -n 's/^MCPE_PAD=//p' "$f" | tail -1)
  if [ -n "$PAD" ] && { [ -e "$PAD" ] || [ -e "$(realpath "$PAD" 2>/dev/null || echo /nonexistent)" ]; }; then
    ok "$(basename "$f"): pad $PAD present"
  elif [ -z "$PAD" ]; then
    bad "$(basename "$f"): MCPE_PAD unset"
  else
    bad "$(basename "$f"): pad path $PAD not found (re-run bin/mcpe-pads)"
  fi
done
[ "$found" = 0 ] && warn "no instance-*.conf yet (copy conf/instance-example.conf)"

echo
echo "selftest: $fails fail(s), $warns warning(s)"
[ "$fails" = 0 ]
